{
  "dhp197:0.1": "მცირე კრებული (ხუდაკა-ნიკაია) ",
  "dhp197:0.2": "ჭეშმარიტების გზა (დჰამაპადა) 197-208 ",
  "dhp197:0.3": "15. ნეტარება ",
  "dhp197:0.4": "",
  "dhp197:1": "ვიცხოვროთ უაღრესად ნეტარად, ",
  "dhp197:2": "სიძულვილის გარეშე მოძულეთ შორის. ",
  "dhp197:3": "მოძულე ადამიანთ შორის, ",
  "dhp197:4": "ვიცხოვროთ სიძულვილისგან თავისუფლებმა. ",
  "dhp198:1": "ვიცხოვროთ უაღრესად ნეტარად, ",
  "dhp198:2": "სნეულების გარეშე სნეულთა შორის. ",
  "dhp198:3": "სნეულ ადამიანთ შორის, ",
  "dhp198:4": "ვიცხოვროთ სნეულებისგან თავისუფლებმა. ",
  "dhp199:1": "ვიცხოვროთ უაღრესად ნეტარად, ",
  "dhp199:2": "შურის გარეშე შურიანთა შორის. ",
  "dhp199:3": "შურიან ადამიანთ შორის, ",
  "dhp199:4": "ვიცხოვროთ შურისგან თავისუფლებმა. ",
  "dhp200:0": "",
  "dhp200:1": "ვიცხოვროთ უაღრესად ნეტარად ",
  "dhp200:2": "ჩვენ, ვისაც არაფერი გვაბადია. ",
  "dhp200:3": "ნეტარებით ვიკვებოთ, ",
  "dhp200:4": "როგორც მანათობელმა, სხივმოსილმა ღმერთებმა. ",
  "dhp201:0": "",
  "dhp201:1": "გამარჯვება შუღლს ბადებს; ",
  "dhp201:2": "დამარცხებულს კი უკმაყოფილოდ სთვლემს. ",
  "dhp201:3": "მშვიდი ნეტარებით თვლემს, ",
  "dhp201:4": "რამეთუ უკან მოიტოვა გამარჯვებაც და დამარცხებაც. ",
  "dhp202:0": "",
  "dhp202:1": "არ არსებობს ცეცხლი ლტოლვის მსგავსი, ",
  "dhp202:2": "დანაშაული – სიძულვილის მსგავსი, ",
  "dhp202:3": "ტანჯვა – ხუთი კომპონენტის მსგავსი, ",
  "dhp202:4": "ხოლო ნეტარება – სიმშვიდის მსგავსი. ",
  "dhp203:0": "",
  "dhp203:1": "შიმშილი უდიდესი სნეულებაა, ",
  "dhp203:2": "ხოლო განპირობებული მოვლენები – უდიდესი ტანჯვა. ",
  "dhp203:3": "ვინც ამას ჭეშმარიტად შეიცნობს, ",
  "dhp203:4": "მისთვის ნიბანა უზენაესი ნეტარებაა. ",
  "dhp204:0": "",
  "dhp204:1": "ჯანმრთელობა უდიდესი მონაპოვარია, ",
  "dhp204:2": "ხოლო კმაყოფილება – უზენაესი სიმდიდრე. ",
  "dhp204:3": "ნდობა უზენაესი ოჯახია, ",
  "dhp204:4": "ხოლო ნიბანა – უზენაესი ნეტარება. ",
  "dhp205:0": "",
  "dhp205:1": "ვინც განმარტოებისა ",
  "dhp205:2": "და სიმშვიდის ნექტარი შესვა, ",
  "dhp205:3": "ჭეშმარიტების ნექტარს დაწაფებული, ",
  "dhp205:4": "განავისუფლდა შფოთისა და ბოროტებისაგან. ",
  "dhp206:0": "",
  "dhp206:1": "შესანიშნავია კეთილშობილთა ხილვა, ",
  "dhp206:2": "მათთან ყოფნა მუდამ ნეტარებაა. ",
  "dhp206:3": "უგუნურის ხილვას თუ მოერიდები, ",
  "dhp206:4": "მუდამ ნეტარი იქნები. ",
  "dhp207:1": "უგუნურებთან მყოფი, ",
  "dhp207:2": "მათ ტანჯვას იზიარებს. ",
  "dhp207:3": "უგუნურთან თანაცხოვრება ისევე მტკივნეულია, ",
  "dhp207:4": "როგორც – საკუთარ მტერთან ახლოს ყოფნა. ",
  "dhp207:5": "ნეტარებაა გონიერთან თანაცხოვრება, ",
  "dhp207:6": "როგორც საყვარელ ახლობლებთან შეხვედრა. ",
  "dhp208:1": "მაშასადამე: ",
  "dhp208:2": "გონიერს, ბრძენსა და მცოდნეს, ",
  "dhp208:3": "ზნეობრივად მტკიცეს, აღთქმის დამცველსა და კეთილშობილს – ",
  "dhp208:4": "მიჰყევი ასეთ მართალ და გონიერ ადამიანს, ",
  "dhp208:5": "როგორც მთვარე მიჰყვება ვარსკვალვთა კვალს. ",
  "dhp208:6": ""
}