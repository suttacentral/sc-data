{
  "dhp21:0.1": "მცირე კრებული (ხუდაკა–ნიკაია) ",
  "dhp21:0.2": "ჭეშმარიტების გზა (დჰამაპადა) 21-23 ",
  "dhp21:0.3": "2. გულმოდგინება ",
  "dhp21:0.4": "",
  "dhp21:1": "სიფხიზლე სიკვდილისგან თავისუფალი მდგომარეობაა; ",
  "dhp21:2": "დაუდევრობა კი – სიკვდილის. ",
  "dhp21:3": "ფხიზელნი არ კვდებიან, ",
  "dhp21:4": "ვინც დაუდევარია – ის უკვე მკვდარია. ",
  "dhp22:1": "ხვდებიან რა ამ სხვაობას, ",
  "dhp22:2": "ფხიზელნი ხარობენ ",
  "dhp22:3": "საკუთარი სიფხიზლით ",
  "dhp22:4": "და ნეტარებენ დიადთა სამკვიდროში. ",
  "dhp23:1": "ბრძენი, რომელიც მუდამ მედიტირებს ",
  "dhp23:2": "დიდი მონდომებით, ",
  "dhp23:3": "მიაღწევს ნიბანას – ",
  "dhp23:4": "უზენაეს თავშესაფარს. ",
  "dhp24:0": "",
  "dhp24:1": "ბეჯითი და გაცნობიერებული, ",
  "dhp24:2": "საქმით წმინდა და ყურადღებიანი, ",
  "dhp24:3": "მოზომილი, მართალი და გულმოდგინე – ",
  "dhp24:4": "ასეთის დიდება მხოლოდ იზრდება. ",
  "dhp25:0": "",
  "dhp25:1": "სიბეჯითითა და გულმოდგინებით, ",
  "dhp25:2": "მოზომვითა და თავშეკავებით, ",
  "dhp25:3": "გონიერი ადამიანი ქმნის კუნძულს, ",
  "dhp25:4": "რომელსაც ვერაფერი წალეკავს. ",
  "dhp26:0": "",
  "dhp26:1": "სულელნი და უგუნურნი ",
  "dhp26:2": "დაუდევრობას ეწაფებიან. ",
  "dhp26:3": "მაგრამ ბრძენნი – გულმოდგინებას იცავენ, ",
  "dhp26:4": "როგორც საკუთარ, უძვირფასეს განძს. ",
  "dhp27:1": "არ მიჰყო ხელი დაუდევრობას, ",
  "dhp27:2": "არ გაგიტაცოს ხორციელმა ვნებამ; ",
  "dhp27:3": "ვინაიდან, უხვ ნეტარებას ",
  "dhp27:4": "გულმოდგინებითა და მედიტაციით მოიპოვებ. ",
  "dhp28:0": "",
  "dhp28:1": "როდესაც ბრძენი დაუდევრობას ",
  "dhp28:2": "გულმოდგინებით განდევნის, ",
  "dhp28:3": "იგი მაღლდება სიბრძნის კაბადონზე ",
  "dhp28:4": "და თავად უმწუხრო, გადაჰყურებს ხალხის მწუხარებას, ",
  "dhp28:5": "როგორც მთის მწვერვალზე მდგომი ბრძენი ",
  "dhp28:6": "გადმოჰყურებს დაბლა მყოფ სულელებს. ",
  "dhp29:0": "",
  "dhp29:1": "ფხიზელი არაფხიზელთ შორის, ",
  "dhp29:2": "მძინარეთ შორის მღვიძარე – ",
  "dhp29:3": "ჭეშმარიტად ბრძენი მათ უკან მოიტოვებს, ",
  "dhp29:4": "როგორც მარდი ცხენი – დაუძლურებულს. ",
  "dhp30:0": "",
  "dhp30:1": "მაგჰავამ ღმერთთა შორის უპირატესობა ",
  "dhp30:2": "სიფხიზლით მოიპოვა. ",
  "dhp30:3": "ხალხი აფასებს გულმოდგინებას, ",
  "dhp30:4": "დაუდევრობას კი – აძაგებს. ",
  "dhp31:0": "",
  "dhp31:1": "გულმოდგინებე ბერი ",
  "dhp31:2": "რომელიც დაუდევრობას ერიდება, ",
  "dhp31:3": "წინ მიიწევს და ",
  "dhp31:4": "ანადგურებს ბორკილებს, დიდსა თუ მცირეს, ვით ცეცხლი. ",
  "dhp32:0": "",
  "dhp32:1": "გულმოდგინე ბერი, ",
  "dhp32:2": "რომლიც დაუდევრობას ერიდება, ",
  "dhp32:3": "არ დამარცხდება ",
  "dhp32:4": "და ნიბანას მიუახლოვდება. ",
  "dhp32:5": ""
}