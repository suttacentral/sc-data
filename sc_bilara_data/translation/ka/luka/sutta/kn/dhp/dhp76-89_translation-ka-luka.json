{
  "dhp76:0.1": "მცირე კრებული (ხუდაკა–ნიკაია) ",
  "dhp76:0.2": "ჭეშმარიტების გზა (დჰამაპადა) 76-89 ",
  "dhp76:0.3": "6. ბრძენნი ",
  "dhp76:1": "ის, ვინც ნაკლზე მიგითითებს, ",
  "dhp76:2": "შენთვის ფარული განძის გზამკვლევია. ",
  "dhp76:3": "ახლოს იყავი მასთან, ვინც ",
  "dhp76:4": "ბრძენი და გონიერია და შეცდომას გისწორებს, როდესაც საჭიროა. ",
  "dhp76:5": "ასეთ მიუკერძოებელ ადამიანთან სიახლოვით, ",
  "dhp76:6": "საქმეს იუმჯობესებ და არა – პირიქით. ",
  "dhp77:1": "დაარიგე და ასწავლე; ",
  "dhp77:2": "ალაგმე ბიწიერება; ",
  "dhp77:3": "ასე კეთილთათვის საყვარელი იქნები, ",
  "dhp77:4": "ბოროტთათვის კი – საძულველი. ",
  "dhp78:1": "ნუ დაუმეგობრდები უვარგისს, ",
  "dhp78:2": "ნურც მდაბიოთა გარემოცვაში იქნები. ",
  "dhp78:3": "დაუმეგობრდი კეთილშობილს ",
  "dhp78:4": "და იყავი საუკეთესოთა გარემოცვაში. ",
  "dhp79:1": "ვინც სწავლებას ეწაფება, მშვიდად სთვლემს ",
  "dhp79:2": "და გულიც სუფთა აქვს. ",
  "dhp79:3": "ბრძენი მუდამ ხარობს იმ სწავლებით, ",
  "dhp79:4": "რომელსაც კეთილშობილი ქადაგებს. ",
  "dhp80:1": "კალაპოტს წყალი მიჰყვება, ",
  "dhp80:2": "ისარს – ჯოლბორდი თლის, ",
  "dhp80:3": "ხეს დურგალი ამუშავებს, ",
  "dhp80:4": "ბრძენნი კი, საკუთარ თავებს იმორჩილებენ. ",
  "dhp81:1": "როგორც სალ კლდეს ",
  "dhp81:2": "ვერ დაძრავს ქარი, ",
  "dhp81:3": "ისევე ვერ შეძრავს ბრძენს ",
  "dhp81:4": "გაკიცხვა, ანდა ქება. ",
  "dhp82:1": "ბრძენი, რომელიც ",
  "dhp82:2": "სწავლებას ისმენს, ",
  "dhp82:3": "ღრმა ტბასავით ",
  "dhp82:4": "წმინდა და კამკამა არის. ",
  "dhp83:1": "ღირსეულნი ყველაფერს თმობენ, ",
  "dhp83:2": "არ ეშურებიან სურვილების დაკმაყოფილებას. ",
  "dhp83:3": "ბედნიერება იქნება თუ ტანჯვა, ",
  "dhp83:4": "ისინი არც სასოწარკვეთას მიეცემიან, და არც აღტაცებაში არიან. ",
  "dhp84:1": "ნურასოდეს ნუ ისურვებ, უსამართლო გზით წარმატების მოპოვებას, ",
  "dhp84:2": "ნურც შენთვის და ნურც სხვისთვის. ",
  "dhp84:3": "არ დახარბდე შთამომავლობას, სიმდიდრეს, ანდაც ძალაუფლებას. ",
  "dhp84:4": "იყავი კეთილზნეობრივი, ბრძენი და სამართლიანი. ",
  "dhp85:1": "ძალიან ცოტა არის ისეთი, ",
  "dhp85:2": "რომელიც შორეულ ნაპირს აღწევს. ",
  "dhp85:3": "დანარჩენნი კი – ",
  "dhp85:4": "ამ ნაპირზევე დარბიან. ",
  "dhp86:1": "ვინც კარგად ახსნილი სწავლების ",
  "dhp86:2": "მიხედვით იქცევა, ",
  "dhp86:3": "თავს დააღწევს სიკვდილის მეუფებას, ",
  "dhp86:4": "რომლის გადალახვაც ასეოდენ რთულია. ",
  "dhp87:1": "ბრძენი მანკიერ თვისებებს უნდა განერიდოს ",
  "dhp87:2": "და უმანკოება განივითაროს. ",
  "dhp87:3": "რთულია სახლ-კარის დატოვებითა და ",
  "dhp87:4": "განმარტოებით სიამოვნება, ",
  "dhp88:1": "მაგრამ ეცადე, იპოვო მასში კმაყოფილება ",
  "dhp88:2": "და ამქვეყნიერი სიამოვნება უკან მოიტოვო. ",
  "dhp88:3": "ბრძენი, რომელსაც არაფერი აბადია, ",
  "dhp88:4": "გონებრივი მანკიერებებისგან განიწმინდება. ",
  "dhp89:1": "ვისი გონებაც სწორად არის განვითარებული ",
  "dhp89:2": "გამოღვიძების საყრდენებით, ",
  "dhp89:3": "ვინც უკუაგდებს მიჯაჭვულობას ",
  "dhp89:4": "და არაფერს არ ებღაუჭება, ",
  "dhp89:5": "მანკისაგან დაცლილი და ბრწყინვალე, ",
  "dhp89:6": "ამქვეყნადვე აღწევს საბოლოო ნიბანას. ",
  "dhp89:7": ""
}