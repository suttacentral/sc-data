{
  "dhp60:0.1": "მცირე კრებული (ხუდაკა–ნიკაია) ",
  "dhp60:0.2": "ჭეშმარიტების გზა (დჰამაპადა) 60-75 ",
  "dhp60:0.3": "5. უგუნურნი ",
  "dhp60:0.4": "",
  "dhp60:1": "გრძელია ღამე მათთვის, ვისაც ღვიძავთ; ",
  "dhp60:2": "გრძელია სავალი მათთვის, ვინც დაღლილია; ",
  "dhp60:3": "დიდხანს ხეტიალობენ უგუნურნი, ",
  "dhp60:4": "რომელთაც ჭეშმარიტი მოძღვრება არ ესმით. ",
  "dhp61:0": "",
  "dhp61:1": "თუკი ხეტიალისას ვერ იპოვნე მეგზური, ",
  "dhp61:2": "შენი ტოლსწორი ანდაც შენზე უკეთესი, ",
  "dhp61:3": "მაშინ ჯობს მარტო იხეტიალო, ",
  "dhp61:4": "რამეთუ უგუნურთან ვერ იამხანაგებ. ",
  "dhp62:0": "",
  "dhp62:1": "“ეს ვაჟი ჩემია, ეს ქონებაც ჩემია” – ",
  "dhp62:2": "ბორგავს უგუნური. ",
  "dhp62:3": "საკუთარი თავიც კი არ გეკუთვნის შენ, ",
  "dhp62:4": "არამცთუ ვაჟები ან ქონება. ",
  "dhp63:0": "",
  "dhp63:1": "უგუნური, რომელმაც იცის საკუთარი უგუნურება, ",
  "dhp63:2": "ამ საკითხში მაინც არის ბრძენი. ",
  "dhp63:3": "სწორედ ის არის ჭეშმარიტად უგუნური, ",
  "dhp63:4": "ვისაც თავი ბრძენი ჰგონია. ",
  "dhp64:0": "",
  "dhp64:1": "უგუნური, თუნდაც მთელი ცხოვრება ",
  "dhp64:2": "უსმენდეს სიბრძნეს, ",
  "dhp64:3": "მაინც ვერ იგებს სწავლებას, ",
  "dhp64:4": "როგორც კოვზი ვერ იგებს წვნიანის გემოს. ",
  "dhp65:0": "",
  "dhp65:1": "გონიერი, თუნდაც მცირე ხნით ",
  "dhp65:2": "მოისმინოს სიბრძნე, ",
  "dhp65:3": "მალევე იგებს სწავლებას, ",
  "dhp65:4": "როგორც ენა – წვნიანის გემოს. ",
  "dhp66:0": "",
  "dhp66:1": "უგუნურსა და ბრიყვს ",
  "dhp66:2": "საკუთარ თავზე დიდი მტერი არ ჰყავთ: ",
  "dhp66:3": "მათი მანკიერი ქმედება ",
  "dhp66:4": "ყოველთვის მწარე ნაყოფს ისხამს. ",
  "dhp67:0": "",
  "dhp67:1": "ქმედება, რომელიც ",
  "dhp67:2": "სინანულს, გმინვასა და გოდებას იწვევს, ",
  "dhp67:3": "მოსაწონი არ არის, ",
  "dhp67:4": "რამეთუ მისი ნაყოფი შენთან რჩება. ",
  "dhp68:0": "",
  "dhp68:1": "ქმედება, რომელსაც ",
  "dhp68:2": "არ ნანობ, არამედ გახარებს და გამხიარულებს, ",
  "dhp68:3": "მოსაწონია, ",
  "dhp68:4": "რამეთუ მისი ნაყოფი შენზე აისახება. ",
  "dhp69:0": "",
  "dhp69:1": "სანამ მანკიერების ნაყოფი არ მომწიფდება, ",
  "dhp69:2": "უგუნურს იგი ტკბილი ჰგონია. ",
  "dhp69:3": "როგორც კი ეს მანკიერება მწიფდება, ",
  "dhp69:4": "უგუნური ტანჯვაში ვარდება. ",
  "dhp70:0": "",
  "dhp70:1": "თვიდან თვემდე, სულაც ",
  "dhp70:2": "ნამცეც-ნამცეც მიიღოს საკვები, ",
  "dhp70:3": "უგუნური იმის მეთექვსმეტედიც ვერ იქნება, ",
  "dhp70:4": "ვინც სწავლება ჭეშმარიტად შეიცნო. ",
  "dhp71:0": "",
  "dhp71:1": "რამეთუ, მანკიერი ქმედება ",
  "dhp71:2": "რძესავით მალე არ მჟავდება: ",
  "dhp71:3": "ის ისე დაჰყვება და ახრჩოლებს უგუნურს, ",
  "dhp71:4": "როგორც ნაცარმიყრილი ცეცხლი. ",
  "dhp72:0": "",
  "dhp72:1": "სახელის მოხვეჭას, უგუნურისთვის, ",
  "dhp72:2": "მხოლოდ ზიანი მოაქვს. ",
  "dhp72:3": "რაც კარგი თვისება გააჩნია, იმასაც სპობს ",
  "dhp72:4": "და თავგადახსნილს ტოვებს. ",
  "dhp73:0": "",
  "dhp73:1": "ის ეძებს: პატივისცემას – რომელიც არ აბადია; ",
  "dhp73:2": "აღიარებას – ბერთაგან; ",
  "dhp73:3": "ბატონობას – მონასტერზე; ",
  "dhp73:4": "ღირსებას – სხვის ოჯახებში. ",
  "dhp74:1": "„დაე, ერისკაცებმა და განდეგილებმაც იფიქრონ, რომ ",
  "dhp74:2": "ყველანაირ შრომას მხოლოდ მე ვეწევი. ",
  "dhp74:3": "როდესაც რაიმე არის გადასაწყვეტი, ",
  "dhp74:4": "დაე მხოლოდ ჩემს ნებას დაემორჩილონ“. ",
  "dhp74:5": "ასე ფიქრობს უგუნური, ",
  "dhp74:6": "მისი სიხარბე და სიამაყე კი უფრო და უფრო იზრდება. ",
  "dhp75:0": "",
  "dhp75:1": "მატერიალური სარგებლის გზა და ნიბანას გზა ",
  "dhp75:2": "ორი ძალზედ განსხვავებული რამ არის. ",
  "dhp75:3": "ბუდას მოწაფე ბერი, ",
  "dhp75:4": "რომელსაც ესმის ეს ჭეშმარიტება, ",
  "dhp75:5": "პატივმოყვარეობით ტკბობის ნაცვლად, ",
  "dhp75:6": "განმარტოვებას ამჯობინებს. ",
  "dhp75:7": ""
}