{
  "dhp100:0.1": "მცირე კრებული (ხუდაკა–ნიკაია) ",
  "dhp100:0.2": "ჭეშმარიტების გზა (დჰამაპადა) 100-115 ",
  "dhp100:0.3": "8. ათასნი ",
  "dhp100:0.4": "",
  "dhp100:1": "ათას უაზრო ",
  "dhp100:2": "სიტყვას, ",
  "dhp100:3": "ჯობს ერთი, აზრიანი სიტყვა, ",
  "dhp100:4": "რომელიც სიმშვიდეს მოგგვრის. ",
  "dhp101:0": "",
  "dhp101:1": "ათას უაზრო ",
  "dhp101:2": "სტროფს, ",
  "dhp101:3": "ჯობს ერთი, აზრიანი სტროფი, ",
  "dhp101:4": "რომელიც სიმშვიდეს მოგგვრის. ",
  "dhp102:0": "",
  "dhp102:1": "ას უშინაარსო ",
  "dhp102:2": "სტროფს, ",
  "dhp102:3": "ჯობს სწავლების ერთი ნაწყვეტი, ",
  "dhp102:4": "რომელიც სიმშვიდეს მოგგვრის. ",
  "dhp103:1": "ჭეშმარიტად გამარჯვებული ის ",
  "dhp103:2": "კი არ არის, ვინც ასიათას კაცს მახვილით სძლევს, ",
  "dhp103:3": "არამედ ის, ვინც მხოლოდ ერთს – ",
  "dhp103:4": "საკუთარ თავს. ",
  "dhp104:0": "",
  "dhp104:1": "უდაოდ ჯობს საკუთარ თავს სძლიო, ",
  "dhp104:2": "ვიდრე სხვას. ",
  "dhp104:3": "იმ ადამიანის გამარჯვებას, ",
  "dhp104:4": "რომელმაც საკუთარი თავი დაიმორჩილა ",
  "dhp105:1": "და მარად თავშეკავებულია, ",
  "dhp105:2": "ვერანაირი ღმერთი თუ ნახევარღმერთი, ",
  "dhp105:3": "მარა თუ ციური არსება ",
  "dhp105:4": "ვერ მოსპობს. ",
  "dhp106:0": "",
  "dhp106:1": "ყოველ თვე, თუნდაც მთელი საუკუნის განმავლობაში, ",
  "dhp106:2": "ათასობით მსხვრეპლის შეწირვას, ",
  "dhp106:3": "ჯობს პატივი მიაგო თუნდაც ერთი საათით მას, ",
  "dhp106:4": "ვინც საკუთარი თავი განავითარა. ",
  "dhp106:5": "ეს თაყვანი გაცილებით ჯობს ",
  "dhp106:6": "ასწლოვან მსხვერპლშეწირვას. ",
  "dhp107:0": "",
  "dhp107:1": "ტყეში, წმინდა ცეცხლის ",
  "dhp107:2": "მსახურებას ასი წლის განმავლობაში, ",
  "dhp107:3": "ჯობს პატივი მიაგო თუნდაც ერთი საათით მას, ",
  "dhp107:4": "ვინც საკუთარი თავი განავითარა. ",
  "dhp107:5": "ეს თაყვანი გაცილებით ჯობს ",
  "dhp107:6": "ასწლოვან მსხვერპლშეწირვას. ",
  "dhp108:0": "",
  "dhp108:1": "წრფელთა წინაშე ქედის ",
  "dhp108:2": "მოხრის მეოთხედადაც კი არ ღირს ",
  "dhp108:3": "არანაირი მსხვერპლი, ",
  "dhp108:4": "რომელსაც ერთი წლის განმავლობაში სწირავს კარგის მქმნელი. ",
  "dhp109:0": "",
  "dhp109:1": "ვისაც სჩვევია ქედის მოხრა ",
  "dhp109:2": "და უფროსთა პატივისცემა, ",
  "dhp109:3": "ოთხი რამ ემატება: ",
  "dhp109:4": "სიცოცხლის ხანგრძლივობა, მშვენება, ბედნიერება და ძალა. ",
  "dhp110:0": "",
  "dhp110:1": "ასი წელი ცხოვრებას, ",
  "dhp110:2": "უზნეოდ და გონებაგაფანტულად, ",
  "dhp110:3": "ჯობს ერთი დღე იცხოვრო, ",
  "dhp110:4": "ზნეობრივად და ჩაღრმავებულად. ",
  "dhp111:0": "",
  "dhp111:1": "ასი წელი ცხოვრებას, ",
  "dhp111:2": "უგუნურად და გონებაგაფანტულად, ",
  "dhp111:3": "ჯობს ერთი დღე იცხოვრო, ",
  "dhp111:4": "ბრძნულად და ჩაღრმავებულად. ",
  "dhp112:0": "",
  "dhp112:1": "ასი წელი ცხოვრებას, ",
  "dhp112:2": "ზარმაცად და უღონოდ, ",
  "dhp112:3": "ჯობს ერთი დღე იცხოვრო, ",
  "dhp112:4": "მედგრად და შემართებით. ",
  "dhp113:0": "",
  "dhp113:1": "ასი წელი ცხოვრებას ისე, ",
