{
  "dhp146:0.1": "მცირე კრებული (ხუდაკა-ნიკაია) ",
  "dhp146:0.2": "ჭეშმარიტების გზა (დჰამაპადა) 146-156 ",
  "dhp146:0.3": "11. მხცოვანება ",
  "dhp146:0.4": "",
  "dhp146:1": "რად ღირს ხალისი, ანდაც სიცილი, ",
  "dhp146:2": "როდესაც ცეცხლი მუდამ გიზგიზებს? ",
  "dhp146:3": "სიბნელით მოცულნო, ",
  "dhp146:4": "ნუთუ არ ეძებთ სინათლეს? ",
  "dhp147:0": "",
  "dhp147:1": "შეიცანი ეს მორთული თოჯინა, ",
  "dhp147:2": "სხეული, რომელიც წყლულებით არის სავსე, ",
  "dhp147:3": "სნეული, ათასგვარი ზრახვით შეპყრობილი, ",
  "dhp147:4": "რომელშიც არაფერია მარადიული. ",
  "dhp148:0": "",
  "dhp148:1": "ეს სხეული, დაუძლურებული და სუსტი, ",
  "dhp148:2": "სნეულებათა ბუდეა, ხრწნადია. ",
  "dhp148:3": "ეს მყრალი გვამი გაიხრწნება, ",
  "dhp148:4": "რამეთუ სიცოცხლე სიკვდილით მთავრდება. ",
  "dhp149:0": "",
  "dhp149:1": "ეს მტრედისფერი ძვლები, ",
  "dhp149:2": "შემოდგომის გამხმარი გოგრებივითაა ",
  "dhp149:3": "მიმობნეული – ",
  "dhp149:4": "რა სასიხარულოა მათი დანახვა? ",
  "dhp150:0": "",
  "dhp150:1": "ეს ძვლის ციხე, ",
  "dhp150:2": "ხორცითა და სისხლით არის შელესილი; ",
  "dhp150:3": "აქ მხცოვანება და სიკვდილი იმალებიან, ",
  "dhp150:4": "ამპარტავნებასა და სიძულვილთან ერთად. ",
  "dhp151:0": "",
  "dhp151:1": "ხელმწიფეთა მორთული ეტლებიც კი ცვდება ",
  "dhp151:2": "და ეს სხეულიც ბერდება. ",
  "dhp151:3": "მაგრამ, სათნოთა სწავლება არასოდეს ბერდება – ",
  "dhp151:4": "ამიტომაც, სათნონი სათნოთ ასწავლიან. ",
  "dhp152:0": "",
  "dhp152:1": "უგუნური ადამიანი ",
  "dhp152:2": "ხარივით ბერდება – ",
  "dhp152:3": "მისი სხეული იზრდება, ",
  "dhp152:4": "ხოლო მისი სიბრძნე – არა. ",
  "dhp153:0": "",
  "dhp153:1": "უთვალავი კვლავშობით ვიხეტიალე, ",
  "dhp153:2": "შეგნების გარეშე, ",
  "dhp153:3": "ამაოდ ვეძებდი სახლის მშენებელს; ",
  "dhp153:4": "კვლავშობა ტანჯვაა. ",
  "dhp154:1": "აჰა, გიხილე, სახლის მშენებელო! ",
  "dhp154:2": "კვლავ ვეღარ ააშენებ სახლს! ",
  "dhp154:3": "შენი საყრდენები დამსხვრეულია, ",
  "dhp154:4": "შენი სახურავი – დანგრეული. ",
  "dhp154:5": "გონება განთავისუფლდა და ",
  "dhp154:6": "ლტოლვა მოსპო. ",
  "dhp155:0": "",
  "dhp155:1": "სიჭაბუკეში სულიერი გზა უგულებელყვეს ",
  "dhp155:2": "და ვერც სიმდიდრე მოიხვეჭეს. ",
  "dhp155:3": "ახლა სხედან ბებერი ყანჩებივით, ",
  "dhp155:4": "უთევზო გუბესთან. ",
  "dhp156:1": "სიჭაბუკეში სულიერი გზა უგულებელყვეს ",
  "dhp156:2": "და ვერც სიმდიდრე მოიხვეჭეს. ",
  "dhp156:3": "ახლა ყრიან დამტვრეული ისრებივით ",
  "dhp156:4": "და ნაღვლიანად მისტირიან წარსულს. ",
  "dhp156:5": ""
}