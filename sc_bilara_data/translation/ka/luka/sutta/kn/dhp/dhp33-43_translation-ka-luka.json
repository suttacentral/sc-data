{
  "dhp33:0.1": "მცირე კრებული (ხუდაკა–ნიკაია) ",
  "dhp33:0.2": "ჭეშმარიტების გზა (დჰამაპადა) 33-43 ",
  "dhp33:0.3": "3. გონი ",
  "dhp33:0.4": "",
  "dhp33:1": "გონი მოუსვენარი და მერყევია, ",
  "dhp33:2": "რთულია დაიცვა ან ალაგმო. ",
  "dhp33:3": "ბრძენი გონს ისე მომართავს, ",
  "dhp33:4": "როგორც ჯოლბორდი – ისარს. ",
  "dhp34:1": "გონი ისე ფართხალებს ",
  "dhp34:2": "მარას წინაღმდეგ ბრძოლაში, ",
  "dhp34:3": "როგორც თევზი, რომელიც წყლიდან ამოიყვანეს ",
  "dhp34:4": "და ნაპირზე მოისროლეს. ",
  "dhp35:0": "",
  "dhp35:1": "რთულია მისი მოთოკვა, მოუსვენარია, ",
  "dhp35:2": "იქ მიიჩქარის, სადაც მოესურვება; ",
  "dhp35:3": "კარგია გონის მოთვინიერება, ",
  "dhp35:4": "რადგან თვინიერ გონს ბედნიერება მოაქვს. ",
  "dhp36:0": "",
  "dhp36:1": "რთულია მისი შემჩნევა, ფაქიზია, ",
  "dhp36:2": "იქ მიიჩქარის, სადაც მოესურვება; ",
  "dhp36:3": "ბრძენი გონს წვრთვნის, ",
  "dhp36:4": "რადგან გაწვრთნილ გონს ბედნიერება მოაქვს. ",
  "dhp37:0": "",
  "dhp37:1": "გონი ბევრს მოგზაურობს, მარტო დახეტიალობს, ",
  "dhp37:2": "უსხეულოა, გულის კუნჭულში იმალება. ",
  "dhp37:3": "ვინც გონს დაიმორჩილებს, ",
  "dhp37:4": "მარას ბორკილესგანაც თავისუფლდება. ",
  "dhp38:0": "",
  "dhp38:1": "ვისაც არამტკიცე გონი აქვს, ",
  "dhp38:2": "ვისაც არ ესმის ჭეშმარიტი მოძღვრება, ",
  "dhp38:3": "ვისი რწმენაც მერყევია – ",
  "dhp38:4": "ვერ სრულყოფს საკუთარ სიბრძნეს. ",
  "dhp39:1": "ვისი გონიც დასნეულებული არ არის, ",
  "dhp39:2": "ვისი გულიც უმწიკვლოა, ",
  "dhp39:3": "ვინც განთავისუფლდა კეთილისა და ბოროტისაგან – ",
  "dhp39:4": "ფხიზლობს და უშიშარია. ",
  "dhp40:0": "",
  "dhp40:1": "ვინაიდან ეს სხეული თიხის ჭურჭელივით სათუთია, ",
  "dhp40:2": "განამტკიცე გონი ზედაციხესავით, ",
  "dhp40:3": "შეერკინე მარას სიბრძნის მახვილით, ",
  "dhp40:4": "გაუფრთხილდი მონაპოვარს და არ დაცხრე. ",
  "dhp41:0": "",
  "dhp41:1": "ძალიან მალე ეს სხეული ",
  "dhp41:2": "უვარგისი ნაფოტივით მოსროლილი ",
  "dhp41:3": "და ცნობიერებისაგან დაცლილი, ",
  "dhp41:4": "ამ მიწას მიებარება. ",
  "dhp42:0": "",
  "dhp42:1": "არასწორად მიმართული გონი ",
  "dhp42:2": "იმაზე მეტ ზიანს მოგიტანს, ",
  "dhp42:3": "ვიდრე მოძულე მოძულეს, ",
  "dhp42:4": "ანდაც მტერი მოწინააღმდეგეს. ",
  "dhp43:0": "",
  "dhp43:1": "სწორად მიმართული გონი ",
  "dhp43:2": "კი უფრო გარგებს, ",
  "dhp43:3": "ვიდრე საკუთარი დედა ან მამა, ",
  "dhp43:4": "ანდაც ნებისმიერი სხვა ნათესავი. ",
  "dhp43:5": ""
}