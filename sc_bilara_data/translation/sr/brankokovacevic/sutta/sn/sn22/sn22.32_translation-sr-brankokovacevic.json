{
  "sn22.32:0.1": "Budini govori tematski grupisani 22.32 ",
  "sn22.32:0.2": "3. Teret ",
  "sn22.32:0.3": "Lomno ",
  "sn22.32:1.1": "Kraj Sāvatthīja. ",
  "sn22.32:1.2": "„Monasi, izložiću vam ono što je lomno i ono što je nelomno. ",
  "sn22.32:1.3": "Poslušajte. ",
  "sn22.32:1.4": "A šta je to, monasi, lomno, a šta nelomno? ",
  "sn22.32:1.5": "Oblik je, monasi, lomno. ",
  "sn22.32:1.6": "Njegov prestanak, smirivanje i nestanak – to je nelomno. ",
  "sn22.32:1.7": "Osećaj je lomno… ",
  "sn22.32:1.8": "",
  "sn22.32:1.9": "Opažaj je lomno… ",
  "sn22.32:1.10": "Mentalni obrasci su lomno. ",
  "sn22.32:1.11": "",
  "sn22.32:1.12": "Svest je lomno. ",
  "sn22.32:1.13": "Njen prestanak, smirivanje i nestanak – to je nelomno.” ",
