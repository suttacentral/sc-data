{
  "iti56:0.1": "Taip bylota 56 ",
  "iti56:0.2": "Trejetukų knyga ",
  "iti56:0.3": "1. Pirmasis skyrius ",
  "iti56:0.4": "Pirmoji sutta apie antplūdžius ",
  "iti56:1.1": "Aš girdėjau, kad taip tikrai bylojo Palaimintasis, taip bylojo <i lang='pi' translate='no'>Arahantas</i>: ",
  "iti56:2.1": "„Esti, vienuoliai, šie trys antplūdžiai. ",
  "iti56:2.2": "Kokios trys? ",
  "iti56:2.3": "Juslinių malonumų geismo antplūdis, būties troškimo antplūdis ir neišmanymo antplūdis. ",
  "iti56:2.4": "Šie yra trys antplūdžiai.” ",
  "iti56:2.5": "Apie tai Palaimintasis kalbėjo. ",
  "iti56:2.6": "Taip pasakyta apie tai: ",
  "iti56:3.1": "„Susitelkęs, su aiškiu supratimu, ",
  "iti56:3.2": "atidus Budos mokinys ",
  "iti56:3.3": "supranta antplūdžius, ",
  "iti56:3.4": "jų radimąsi, ",
  "iti56:4.1": "kur jos išnyksta ",
  "iti56:4.2": "ir kelią vedantį į jų išsekimą. ",
  "iti56:4.3": "Su antplūdžių išsekimu, vienuolis ",
  "iti56:4.4": "numalšina alkį ir galutinai užgęsta.” ",
  "iti56:5.1": "Apie tai taip pat Palaimintasis kalbėjo. Taip aš girdėjau. ",
  "iti56:5.2": ""
}