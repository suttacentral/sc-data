{
  "an7.5:0.1": "Palaipsninių suttų rinkinys 7 ",
  "an7.5:0.2": "1. Turtai ",
  "an7.5:0.3": "5. Trumpai apie turtus ",
  "an7.5:1.1": "Vienuoliai, yra šie septyni turtai. ",
  "an7.5:1.2": "Kokie septyni? ",
  "an7.5:1.3": "Tikėjimo turtas, dorovės turtas, sąžinės turtas, pasekmių paisymo turtas, mokytumo turtas, dosnumo turtas, išminties turtas. ",
  "an7.5:1.4": "Štai šie, vienuoliai, yra septyni turtai. ",
  "an7.5:2.1": "Tikėjimo ir dorovės turtai, ",
  "an7.5:2.2": "sąžinės ir pasekmių paisymo turtai, ",
  "an7.5:2.3": "mokytumo ir dosnumo turtai, ",
  "an7.5:2.4": "ir išmintis – septintasis turtas. ",
  "an7.5:3.1": "Žmogų turintį tokius turtus – ",
  "an7.5:3.2": "moterį ar vyrą – ",
  "an7.5:3.3": "vadina turtuoliu, ",
  "an7.5:3.4": "jo gyvenimas nėra tuščias. ",
  "an7.5:4.1": "Tad atmindamas Budų nurodymus,",
  "an7.5:4.2": "te išmintingasis pasišvenčia ",
  "an7.5:4.3": "tikėjimui, dorovei,",
  "an7.5:4.4": "pasitikėjimui ir <i lang='pi' translate='no'>Dhammos</i> matymui.“ ",
  "an7.5:4.5": ""
}