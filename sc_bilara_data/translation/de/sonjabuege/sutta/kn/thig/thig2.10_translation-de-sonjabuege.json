{
  "thig2.10:0.1": "Lieder der Therī 2.10 ",
  "thig2.10:0.2": "Das Zweierbuch ",
  "thig2.10:0.3": "Das Lied der Therī Sāmā ",
  "thig2.10:1.1": "Vier oder fünfmal ",
  "thig2.10:1.2": "verließ ich die Hütte, ",
  "thig2.10:1.3": "unerreicht der Geistesfrieden, ",
  "thig2.10:1.4": "nicht Herrin über den Geist. ",
  "thig2.10:1.5": "Für mich ist dies nun die achte Nacht, ",
  "thig2.10:1.6": "seit der Durst verlöscht ist. ",
  "thig2.10:2.1": "Nach all den quälenden Geisteszuständen ",
  "thig2.10:2.2": "erfreue ich mich der Wachsamkeit. ",
  "thig2.10:2.3": "Die Vernichtung des Durstes wurde mir zuteil, ",
  "thig2.10:2.4": "gemeistert ist die Lehre des Buddha! ",
  "thig2.10:3.1": "",
  "thig2.10:4.1": ""
}