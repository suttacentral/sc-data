{
  "thig5.4:0.1": "Lieder der Therī 5.4 ",
  "thig5.4:0.2": "Das Fünferbuch ",
  "thig5.4:0.3": "Das Lied der Therī Sundarīnandā ",
  "thig5.4:1.1": "Nandā, betrachte den Körper ",
  "thig5.4:1.2": "als krank, unrein und stinkend. ",
  "thig5.4:1.3": "Richte den Geist auf das Abstoßende, ",
  "thig5.4:1.4": "vollständig gesammelt, konzentriert. ",
  "thig5.4:2.1": "Wie dieses ist, so ist jenes, ",
  "thig5.4:2.2": "wie jenes ist, so ist dieses. ",
  "thig5.4:2.3": "Stinkendes, Faules ist in der Tat ",
  "thig5.4:2.4": "nur für Toren etwas Erfreuliches. ",
  "thig5.4:3.1": "Auf diese Weise, Tag und Nacht ",
  "thig5.4:3.2": "kontemplierte ich unermüdlich. ",
  "thig5.4:3.3": "Dann, durch eigene Weisheit durchdringend, ",
  "thig5.4:3.4": "sah ich! ",
  "thig5.4:4.1": "Mir, dieser Achtsamen, äußerst Sorgfältigen, ",
  "thig5.4:4.2": "offenbarte sich dieser Körper, ",
  "thig5.4:4.3": "so wie er ist, ",
  "thig5.4:4.4": "innen und außen. ",
  "thig5.4:5.1": "Da verlor ich das Interesse an körperlichen Vorgängen. ",
  "thig5.4:5.2": "Innerlich distanziert von Lust, ",
  "thig5.4:5.3": "wachsam und unbehindert, ",
  "thig5.4:5.4": "bin ich abgekühlt, verloschen. ",
  "thig5.4:6.1": ""
}