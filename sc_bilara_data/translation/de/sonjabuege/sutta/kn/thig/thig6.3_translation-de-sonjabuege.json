{
  "thig6.3:0.1": "Lieder der Therī 6.3 ",
  "thig6.3:0.2": "Das Sechserbuch ",
  "thig6.3:0.3": "Das Lied der Therī Khemā ",
  "thig6.3:1.1": "„Jung bist du und schön, ",
  "thig6.3:1.2": "ich bin ein junger Mann. ",
  "thig6.3:1.3": "Komm, Khemā, lass uns genießen ",
  "thig6.3:1.4": "zur Musik eines fünfteiligen Orchesters.“ ",
  "thig6.3:2.1": "„Da dieser faulige Körper, ",
  "thig6.3:2.2": "krank und schwach, ",
  "thig6.3:2.3": "mich ekelt und beschämt, ",
  "thig6.3:2.4": "ist Sinnesdurst ganz ausgemerzt. ",
  "thig6.3:3.1": "Schwertern und Speeren gleich sind Sinnesfreuden, ",
  "thig6.3:3.2": "die Komponenten des Erlebens Henkersblock. ",
  "thig6.3:3.3": "Das, was du ‚Sinnesfreude‘ nennst, ",
  "thig6.3:3.4": "ist mir nun ein Gräuel. ",
  "thig6.3:4.1": "Vollständig vernichtet sind die seichten Freuden, ",
  "thig6.3:4.2": "die Masse der Finsternis ist zerschlagen. ",
  "thig6.3:4.3": "So wisse denn, du Übeltäter, ",
  "thig6.3:4.4": "geschlagen bist du, Tod.“ ",
  "thig6.3:5.1": "„Die Sterne verehren, ",
  "thig6.3:5.2": "das Feuer pflegen im Wald, ",
  "thig6.3:5.3": "so wie die Dinge wirklich sind, das sehen sie nicht, ",
  "thig6.3:5.4": "die Narren halten sich für rein. ",
  "thig6.3:6.1": "Ich aber bin eine, die den Erwachten, ",
  "thig6.3:6.2": "den höchsten der Menschen, verehrt. ",
  "thig6.3:6.3": "Befreit von allen Leiden, ",
  "thig6.3:6.4": "folge ich den Lehren des Meisters.“ ",
  "thig6.3:7.1": ""
}