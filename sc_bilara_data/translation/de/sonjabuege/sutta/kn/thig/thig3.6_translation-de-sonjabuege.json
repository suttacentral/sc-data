{
  "thig3.6:0.1": "Lieder der Therī 3.6 ",
  "thig3.6:0.2": "Das Dreierbuch ",
  "thig3.6:0.3": "Das Lied der Therī Sukkā ",
  "thig3.6:1.1": "„Was ist nur los mit den Leuten in Rājagaha? ",
  "thig3.6:1.2": "Als hätten sie Honigwein getrunken, lungern sie herum. ",
  "thig3.6:1.3": "Sie folgen der Sukkā nicht, ",
  "thig3.6:1.4": "die die Lehre des Buddha lehrt. ",
  "thig3.6:2.1": "Wohl nur Weise trinken ",
  "thig3.6:2.2": "diese überzeugende, ",
  "thig3.6:2.3": "köstliche und nahrhafte Lehre, ",
  "thig3.6:2.4": "so wie Wanderer eine Regenwolke.“ ",
  "thig3.6:3.1": "„Sukkā, durch Ausübung reiner Lehre ",
  "thig3.6:3.2": "frei von Leidenschaft, gesammelt, ",
  "thig3.6:3.3": "trägt ihren letzten Körper ",
  "thig3.6:3.4": "und hat Māra mit seiner Armee besiegt.“ ",
  "thig3.6:4.1": ""
}