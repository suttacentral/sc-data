{
  "thig5.10:0.1": "Lieder der Therī 5.10 ",
  "thig5.10:0.2": "Das Fünferbuch ",
  "thig5.10:0.3": "Das Lied der Therī Paṭācārā ",
  "thig5.10:1.1": "Das Feldpflügen mit den Pflügen, ",
  "thig5.10:1.2": "das Samensäen in die Erde – ",
  "thig5.10:1.3": "so erwerben junge Männer, ",
  "thig5.10:1.4": "die Frau und Kinder ernähren, Reichtum. ",
  "thig5.10:2.1": "Wie kann es sein, dass ich, tugendhaft, ",
  "thig5.10:2.2": "die Anweisungen des Lehrers befolgend, ",
  "thig5.10:2.3": "unermüdlich, nicht eitel, ",
  "thig5.10:2.4": "das Nibbāna nicht erreiche? ",
  "thig5.10:3.1": "Als ich die Füße ",
  "thig5.10:3.2": "im Wasser gewaschen hatte, ",
  "thig5.10:3.3": "sah ich, wie das Waschwasser ",
  "thig5.10:3.4": "von oben nach unten floß. ",
  "thig5.10:4.1": "Darauf erreichte mein Geist Kontrolle, ",
  "thig5.10:4.2": "gleich einem hochrassigen Pferd. ",
  "thig5.10:4.3": "Darauf nahm ich eine Kerze ",
  "thig5.10:4.4": "und betrat die Hütte für Hauslose. ",
  "thig5.10:4.5": "Nachdem ich das Bett angesehen hatte, ",
  "thig5.10:4.6": "setzte ich mich auf eine Liege. ",
  "thig5.10:5.1": "Darauf nahm ich eine Nadel ",
  "thig5.10:5.2": "und drückte den Docht aus. ",
  "thig5.10:5.3": "Wie das Verlöschen einer Lampe, ",
  "thig5.10:5.4": "so war die Befreiung meines Geistes. ",
  "thig5.10:6.1": ""
}