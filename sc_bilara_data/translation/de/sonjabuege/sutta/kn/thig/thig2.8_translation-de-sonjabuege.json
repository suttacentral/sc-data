{
  "thig2.8:0.1": "Lieder der Therī 2.8 ",
  "thig2.8:0.2": "Das Zweierbuch ",
  "thig2.8:0.3": "Das Lied von Abhayas Mutter, einer Therī ",
  "thig2.8:1.1": "Von den Fußsohlen aufsteigend, Mutter, ",
  "thig2.8:1.2": "dann vom Scheitel herab ",
  "thig2.8:1.3": "betrachte stets den Körper ",
  "thig2.8:1.4": "als unrein und faulig stinkend. ",
  "thig2.8:2.1": "Für eine, die so verweilt, ",
  "thig2.8:2.2": "wird Leidenschaft samt Wurzeln ausgerissen. ",
  "thig2.8:2.3": "Das Leiden ganz und gar vernichtet, ",
  "thig2.8:2.4": "bin ich abgekühlt, verloschen. ",
  "thig2.8:3.1": ""
}