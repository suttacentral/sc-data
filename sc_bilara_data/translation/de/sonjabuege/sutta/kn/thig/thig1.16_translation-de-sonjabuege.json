{
  "thig1.16:0.1": "Lieder der Therī 1.16 ",
  "thig1.16:0.2": "Das Einerbuch ",
  "thig1.16:0.3": "Das Lied der Therī Vuḍḍhapabbajitasumanā ",
  "thig1.16:1.1": "Schlafe glücklich, alte Mutter, ",
  "thig1.16:1.2": "nachdem du dich in Lumpen gehüllt hast. ",
  "thig1.16:1.3": "Gestillt ist nun deine Leidenschaft, ",
  "thig1.16:1.4": "zur Ruhe gekommen bist du, verloschen. ",
  "thig1.16:2.1": ""
}