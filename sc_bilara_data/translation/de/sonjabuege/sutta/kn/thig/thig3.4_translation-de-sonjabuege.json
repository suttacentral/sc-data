{
  "thig3.4:0.1": "Lieder der Therī 3.4 ",
  "thig3.4:0.2": "Das Dreierbuch ",
  "thig3.4:0.3": "Das Lied der Therī Dantikā ",
  "thig3.4:1.1": "Als ich meinen Meditationsplatz ",
  "thig3.4:1.2": "am Berg Geiergipfel verließ, ",
  "thig3.4:1.3": "sah ich einen Elefanten, ",
  "thig3.4:1.4": "der vom Bade am Ufer heraufstieg. ",
  "thig3.4:2.1": "Ein Mann ergriff den Elefantenhaken ",
  "thig3.4:2.2": "und befahl: „Heb deinen Fuß!“ ",
  "thig3.4:2.3": "Der Elefant streckte den Fuß aus, ",
  "thig3.4:2.4": "und der Mann stieg auf den Elefanten. ",
  "thig3.4:3.1": "Als ich das Ungezähmte so ",
  "thig3.4:3.2": "durch Menschenwillen bezähmt sah, ",
  "thig3.4:3.3": "da zähmte ich den Geist, ",
  "thig3.4:3.4": "aus diesem Grund ging ich ja in den Wald. ",
  "thig3.4:4.1": ""
}