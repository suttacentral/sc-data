{
  "thig1.17:0.1": "Lieder der Therī 1.17 ",
  "thig1.17:0.2": "Das Einerbuch ",
  "thig1.17:0.3": "Das Lied der Therī Dhammā ",
  "thig1.17:1.1": "Auf Almosengang wandernd, ",
  "thig1.17:1.2": "auf den Stock gestützt, hinfällig, ",
  "thig1.17:1.3": "fiel ich mit zitternden Gliedern ",
  "thig1.17:1.4": "dort zu Boden. ",
  "thig1.17:1.5": "Als ich die Unzulänglichkeit des Körpers sah, ",
  "thig1.17:1.6": "da wurde mein Herz frei. ",
  "thig1.17:2.1": ""
}