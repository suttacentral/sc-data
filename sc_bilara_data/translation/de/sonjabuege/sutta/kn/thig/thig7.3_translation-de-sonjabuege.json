{
  "thig7.3:0.1": "Strophen der Therī 7.3 ",
  "thig7.3:0.2": "Das Siebenerbuch ",
  "thig7.3:0.3": "Die Strophen der Therī Upacālā ",
  "thig7.3:1.1": "Als eine achtsame Bhikkhunī, die Klarsicht hat, ",
  "thig7.3:1.2": "mit entfalteten Fähigkeiten, ",
  "thig7.3:1.3": "durchdrang ich den beruhigten Zustand, ",
  "thig7.3:1.4": "den niedere Menschen nicht erfahren. ",
  "thig7.3:2.1": "Warum nur möchtest du keine (Wieder) Geburt? ",
  "thig7.3:2.2": "Wiedergeboren, genießt man Sinneslust. ",
  "thig7.3:2.3": "Genieße doch die Liebesfreuden, ",
  "thig7.3:2.4": "dass du (es) später nicht bereust. ",
  "thig7.3:3.1": "Für Geborenes entsteht Tod, ",
  "thig7.3:3.2": "das Abhacken von Händen und Füßen, ",
  "thig7.3:3.3": "Auspeitschen, Einkerkern und Schrecken. ",
  "thig7.3:3.4": "Geborenes kommt zu Leiden! ",
  "thig7.3:4.1": "Da ist (jedoch) der unbezwingbare, völlig Erwachte, ",
  "thig7.3:4.2": "geboren in die Sakyafamilie, ",
  "thig7.3:4.3": "der lehrte mich den Dhamma, ",
  "thig7.3:4.4": "das Beenden von Geburt: ",
  "thig7.3:5.1": "Leiden, das Aufkommen von Leiden, ",
  "thig7.3:5.2": "des Leidens Überwinden, ",
  "thig7.3:5.3": "den edlen achtfachen Pfad, ",
  "thig7.3:5.4": "der zum Aufheben des Leidens führt. ",
  "thig7.3:6.1": "Als ich seine Worte vernommen hatte, ",
  "thig7.3:6.2": "verweilte ich freudig in (seiner) Lehre. ",
  "thig7.3:6.3": "Die drei Wissen habe ich erreicht, ",
  "thig7.3:6.4": "gemeistert ist die Lehre des Buddha! ",
  "thig7.3:7.1": "Die (seichten) Freuden sind völlig vernichtet, ",
  "thig7.3:7.2": "die Masse der Finsternis zerschlagen. ",
  "thig7.3:7.3": "So wisse denn, Übeltäter, ",
  "thig7.3:7.4": "geschlagen bist du, Tod! ",
  "thig7.3:8.1": "",
  "thig7.3:9.1": ""
}