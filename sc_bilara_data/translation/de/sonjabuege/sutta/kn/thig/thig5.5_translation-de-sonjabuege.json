{
  "thig5.5:0.1": "Lieder der Therī 5.5 ",
  "thig5.5:0.2": "Das Fünferbuch ",
  "thig5.5:0.3": "Das Lied der Therī Nanduttarā ",
  "thig5.5:1.1": "Das Feuer, den Mond und die Sonne, ",
  "thig5.5:1.2": "auch die Götter verehrte ich, ",
  "thig5.5:1.3": "zum Flußufer ging ich, ",
  "thig5.5:1.4": "stieg zum Wasser hinab. ",
  "thig5.5:2.1": "Ich nahm viele Gelübde auf mich, ",
  "thig5.5:2.2": "den halben Kopf schor ich, ",
  "thig5.5:2.3": "das Lager bereitete ich auf dem Boden ",
  "thig5.5:2.4": "und aß kein Abendmahl. ",
  "thig5.5:3.1": "Schmuck und Ornamente freuten mich, ",
  "thig5.5:3.2": "ich vergaß auch nicht Öle und Parfüm. ",
  "thig5.5:3.3": "Dem Körper diente ich, ",
  "thig5.5:3.4": "gequält von Leidenschaft und Gier. ",
  "thig5.5:4.1": "Dann aber gewann ich Vertrauen, ",
  "thig5.5:4.2": "zog in die Hauslosigkeit. ",
  "thig5.5:4.3": "Nachdem ich sah, wie mein Körper tatsächlich beschaffen war, ",
  "thig5.5:4.4": "da erlosch die Liebeslust. ",
  "thig5.5:5.1": "Alle Existenzen beendet, ",
  "thig5.5:5.2": "ebenso auch Wünsche und Streben. ",
  "thig5.5:5.3": "Losgelöst von allen Fesseln, ",
  "thig5.5:5.4": "erlangte ich Ruhe des Geistes. ",
  "thig5.5:6.1": ""
}