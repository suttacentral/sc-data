{
  "sn14.22:0.1": "Verbundene Lehrreden 14.22 ",
  "sn14.22:0.2": "2. Das zweite Kapitel ",
  "sn14.22:0.3": "Mit den Trägen beginnend ",
  "sn14.22:1.1": "In Sāvatthī. ",
  "sn14.22:1.2": "„Mönche und Nonnen, Lebewesen kommen zusammen und vereinigen sich aufgrund eines Elements: ",
  "sn14.22:1.3": "die Trägen mit den Trägen … ",
  "sn14.22:1.4": "die Unachtsamen … ",
  "sn14.22:1.5": "die Geistlosen … ",
  "sn14.22:1.6": "die Energischen … ",
  "sn14.22:1.7": "die Achtsamen … die Weisen …“ ",
  "sn14.22:1.8": "",
  "sn14.22:1.9": "(Diese sollten alle in Bezug auf die Vergangenheit, Zukunft und Gegenwart behandelt werden.) ",
