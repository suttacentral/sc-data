{
  "thag2.20:0.1": "Strophen der altehrwürdigen Mönche 2.20 ",
  "thag2.20:0.2": "Das Zweierbuch ",
  "thag2.20:0.3": "2. Das zweite Kapitel ",
  "thag2.20:0.4": "Sirima ",
  "thag2.20:1.1": "Wenn andere jemanden preisen, ",
  "thag2.20:1.2": "der keine Versenkung hat, ",
  "thag2.20:1.3": "so priesen sie vergebens, ",
  "thag2.20:1.4": "da dieser keine Versenkung hat. ",
  "thag2.20:2.1": "Wenn andere jemanden tadeln, ",
  "thag2.20:2.2": "der Versenkung besitzt, ",
  "thag2.20:2.3": "so tadeln sie vergebens, ",
  "thag2.20:2.4": "da dieser Versenkung besitzt. ",
