  "cp26:1.1": "Vgl. <a href='https://suttacentral.net/ja538/de/sabbamitta'>Ja 538</a> ",
  "cp26:1.2": "",
  "cp26:1.3": "„Stumm und verkrüppelt“. (Sujato) ",
  "cp26:1.4": "",
