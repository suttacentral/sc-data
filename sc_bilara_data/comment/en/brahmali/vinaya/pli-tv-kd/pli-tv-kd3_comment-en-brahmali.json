  "pli-tv-kd3:6.10.1": "“Demotion” renders <i lang='pi' translate='no'>niyassa</i>. See Appendix of Technical Terms. ",
  "pli-tv-kd3:6.10.2": "",
  "pli-tv-kd3:6.10.3": "",
