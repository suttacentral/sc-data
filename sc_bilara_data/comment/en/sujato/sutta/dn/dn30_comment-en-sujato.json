  "dn30:1.28.5": "",
  "dn30:1.28.6": "",
  "dn30:1.28.7": "Giving fine coverings leads to fine skin. Less obviously, anger is said to lead to discoloring and ugliness. ",
  "dn30:1.29.1": "",
  "dn30:1.29.2": "",
  "dn30:1.29.3": "",
  "dn30:1.29.4": "",
  "dn30:1.29.5": "",
