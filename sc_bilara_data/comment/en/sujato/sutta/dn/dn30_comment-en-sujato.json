  "dn30:1.18.8": "",
  "dn30:1.18.9": "",
  "dn30:1.18.10": "",
  "dn30:1.18.11": "Even though the community is geographically dispersed, it is still coherent. ",
  "dn30:1.18.12": "",
  "dn30:1.18.13": "",
