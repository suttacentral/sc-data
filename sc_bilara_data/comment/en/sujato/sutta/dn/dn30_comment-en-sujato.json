  "dn30:1.10.4": "",
  "dn30:1.10.5": "Giving up killing results in long life. This seems to be applied by metaphor to having these long and elegant body parts. ",
  "dn30:1.11.1": "",
  "dn30:1.11.2": "",
  "dn30:1.11.3": "",
  "dn30:1.11.4": "",
  "dn30:1.11.5": "",
