  "mn135:7.5": "",
  "mn135:8.1": "A reason for one of the Buddha’s marks (<a href='https://suttacentral.net/dn30/en/sujato#2.7.2'>DN 30:2.7.2</a>). ",
  "mn135:8.2": "",
  "mn135:8.3": "",
  "mn135:8.4": "",
  "mn135:8.5": "",
  "mn135:9.1": "",
  "mn135:9.2": "A person with a “mind like an open sore” (<a href='https://suttacentral.net/an3.25/en/sujato#1.6'>AN 3.25:1.6</a>). ",
