{
  "t765.63:0.1": "本事經卷第三",
  "t765.63:0.2": "二法品第二之一",
  "t765.63:0.3": "(63)",
  "t765.63:0.4": "大唐三藏法師玄奘奉　詔譯",
  "t765.63:1.0": "吾從世尊聞如是語：",
  "t765.63:1.1": "「苾芻當知！若有苾芻成就二分，於現法中多諸憂苦，無喜樂住，有災有患、有惱有燒、有罪有責。",
  "t765.63:1.2": "為諸有情同梵行者之所訶毀，身壞命終生諸惡趣。",
  "t765.63:1.3": "云何為二？",
  "t765.63:1.4": "一、於根門不能守護；",
  "t765.63:1.5": "二、於飲食不善知量。",
  "t765.63:1.6": "諸有苾芻成就此二，於現法中多諸憂苦，無喜樂住，有災有患、有惱有燒、有罪有責。」",
  "t765.63:2.0": "為諸有智同梵行者之所訶毀，身壞命終生諸惡趣。」",
  "t765.63:3.0": "爾時，世尊重攝此義而說頌曰：",
  "t765.63:4.0": "「若不能守護，",
  "t765.63:4.1": "眼等六根門，",
  "t765.63:4.2": "飲食不知量，",
  "t765.63:4.3": "成不信懈怠。",
  "t765.63:5.0": "彼於現法中，",
  "t765.63:5.1": "身心多受苦，",
  "t765.63:5.2": "及有災有患，",
  "t765.63:5.3": "有惱有燒然。",
  "t765.63:6.0": "行住與坐臥，",
  "t765.63:6.1": "若覺若夢中，",
  "t765.63:6.2": "由彼二因緣，",
  "t765.63:6.3": "恒有罪有責。",
  "t765.63:7.0": "居聚落空閑，",
  "t765.63:7.1": "眾中及靜處，",
  "t765.63:7.2": "有智常訶責，",
  "t765.63:7.3": "當生惡趣中。」"
}