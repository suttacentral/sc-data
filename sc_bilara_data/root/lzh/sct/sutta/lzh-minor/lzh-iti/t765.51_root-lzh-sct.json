{
  "t765.51:0.1": "本事經卷第二",
  "t765.51:0.2": "一法品第一之二",
  "t765.51:0.3": "(51)",
  "t765.51:0.4": "大唐三藏法師玄奘奉　詔譯",
  "t765.51:1.0": "吾從世尊聞如是語：",
  "t765.51:1.1": "「苾芻當知！我觀世間無別一法，為諸有學未得心者希求無上安樂果時，作外強緣，如善知識。",
  "t765.51:1.2": "所以者何？",
  "t765.51:1.3": "彼諸有情因善知識，所求皆遂，謂斷眾惡、修習諸善，得無雜染真淨之身。」",
  "t765.51:2.0": "爾時，世尊重攝此義而說頌曰：",
  "t765.51:3.0": "「我觀諸世間，",
  "t765.51:3.1": "無別有一法，",
  "t765.51:3.2": "學未得心者，",
  "t765.51:3.3": "求無上果時，",
  "t765.51:3.4": "為作外強緣，",
  "t765.51:3.5": "如彼善知識。",
  "t765.51:4.0": "親近善知識，",
  "t765.51:4.1": "所求無不成，",
  "t765.51:4.2": "恭敬受其教，",
  "t765.51:4.3": "無放逸奉行，",
  "t765.51:4.4": "速證於涅槃，",
  "t765.51:4.5": "離怖常安樂。」"
}