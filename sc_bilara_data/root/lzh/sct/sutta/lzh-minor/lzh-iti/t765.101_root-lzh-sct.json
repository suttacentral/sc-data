{
  "t765.101:0.1": "本事經卷第五",
  "t765.101:0.2": "二法品第二之三",
  "t765.101:0.3": "(101)",
  "t765.101:0.4": "大唐三藏法師玄奘奉　詔譯",
  "t765.101:1.0": "吾從世尊聞如是語：",
  "t765.101:1.1": "「苾芻當知！諸修行者，同集會時，應作二事：",
  "t765.101:1.2": "一者法言；二者宴默。",
  "t765.101:1.3": "由法言故，審知有德。",
  "t765.101:1.4": "審知德故，便深敬信。",
  "t765.101:1.5": "深敬信故，便往詣彼。",
  "t765.101:1.6": "往詣彼故，親近供事。",
  "t765.101:1.7": "親供事故，求聞正法。",
  "t765.101:1.8": "求聞法故，攝耳不亂。",
  "t765.101:1.9": "耳不亂故，聽聞正法。",
  "t765.101:1.10": "聞正法故，於法通利。",
  "t765.101:1.11": "法通利故，能記持法。",
  "t765.101:1.12": "記持法故，能觀察義。",
  "t765.101:1.13": "觀察義時，堪能於法審諦思惟。",
  "t765.101:1.14": "堪能於法審諦思時，便生欲樂。",
  "t765.101:1.15": "生欲樂已，便得勢力。",
  "t765.101:1.16": "得勢力已，便能稱量。",
  "t765.101:1.17": "由稱量故，便能決擇。",
  "t765.101:1.18": "能決擇故，於諦隨覺，便自了知：",
  "t765.101:1.19": "『我生已盡，梵行已立，所作已辦，不受後有。』",
  "t765.101:2.0": "「由宴默故，心便寂定，清淨鮮白無有瑕釁，離隨煩惱。",
  "t765.101:2.1": "調順堪任，安住不動，堪能引發。",
  "t765.101:2.2": "能引發故，如實了知。",
  "t765.101:2.3": "如實知故，便能厭背。",
  "t765.101:2.4": "能厭背故，便能離欲。",
  "t765.101:2.5": "既離欲已，便得解脫。",
  "t765.101:2.6": "得解脫已，便自了知：",
  "t765.101:2.7": "『我已解脫，我生已盡，梵行已立，所作已辦，不受後有。』",
  "t765.101:3.0": "「汝等苾芻應說上法、應了上法。",
  "t765.101:3.1": "若能如是，乃名真實攝受仙幢。",
  "t765.101:3.2": "非眾集會戲論語言，能正了知諸法實相、能斷諸漏、能證涅槃。",
  "t765.101:3.3": "我常集會宣說上法、了知上法，故名第一攝受仙幢。」",
  "t765.101:4.0": "爾時，世尊重攝此義而說頌曰：",
  "t765.101:5.0": "「行者集會時，",
  "t765.101:5.1": "應修作二事，",
  "t765.101:5.2": "謂寂然宴默，",
  "t765.101:5.3": "及說正法言。",
  "t765.101:6.0": "由說正法言，",
  "t765.101:6.1": "及寂然宴默，",
  "t765.101:6.2": "知諸法實相，",
  "t765.101:6.3": "究竟證涅槃。",
  "t765.101:7.0": "汝等諸苾芻，",
  "t765.101:7.1": "若說了上法，",
  "t765.101:7.2": "乃得名真實，",
  "t765.101:7.3": "攝受大仙幢。",
  "t765.101:8.0": "我常處眾中，",
  "t765.101:8.1": "宣說照了法，",
  "t765.101:8.2": "是故名第一，",
  "t765.101:8.3": "攝受大仙幢。",
  "t765.101:9.0": "若依正法幢，",
  "t765.101:9.1": "能說能修行，",
  "t765.101:9.2": "定速脫生死，",
  "t765.101:9.3": "至究竟涅槃。」"
}