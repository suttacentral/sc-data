{
  "t765.64:0.1": "本事經卷第三",
  "t765.64:0.2": "二法品第二之一",
  "t765.64:0.3": "(64)",
  "t765.64:0.4": "大唐三藏法師玄奘奉　詔譯",
  "t765.64:1.0": "吾從世尊聞如是語：",
  "t765.64:1.1": "「苾芻當知！若有苾芻成就二分，於現法中多諸喜樂，無憂苦住，無災無患、無惱無燒、無罪無責。",
  "t765.64:1.2": "為諸有智同梵行者之所稱讚，身壞命終生諸善趣。",
  "t765.64:1.3": "云何為二？",
  "t765.64:1.4": "一、於根門能自守護；",
  "t765.64:1.5": "二、於飲食能善知量。",
  "t765.64:1.6": "諸有苾芻成就此二，於現法中多諸喜樂，無憂苦住，無災無患、無惱無燒、無罪無責。",
  "t765.64:1.7": "為諸有智同梵行者之所稱讚，身壞命終生諸善趣。」",
  "t765.64:2.0": "爾時，世尊重攝此義而說頌曰：",
  "t765.64:3.0": "「若自能守護，",
  "t765.64:3.1": "眼等六根門，",
  "t765.64:3.2": "飲食善知量，",
  "t765.64:3.3": "成就信精進。",
  "t765.64:4.0": "彼於現法中，",
  "t765.64:4.1": "身心多受樂，",
  "t765.64:4.2": "及無災無患，",
  "t765.64:4.3": "無惱無燒然。",
  "t765.64:5.0": "行住與坐臥，",
  "t765.64:5.1": "若覺若夢中，",
  "t765.64:5.2": "由彼二因緣，",
  "t765.64:5.3": "恒無罪無責。",
  "t765.64:6.0": "居聚落空閑，",
  "t765.64:6.1": "眾中及靜處，",
  "t765.64:6.2": "有智常稱讚，",
  "t765.64:6.3": "當生善趣中。」"
}