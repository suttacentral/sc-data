{
  "t765.82:0.1": "本事經卷第四",
  "t765.82:0.2": "二法品第二之二",
  "t765.82:0.3": "(82)",
  "t765.82:0.4": "大唐三藏法師玄奘奉　詔譯",
  "t765.82:1.0": "吾從世尊聞如是語：",
  "t765.82:1.1": "「苾芻當知！若有苾芻減省睡眠，具念正知，心常安住悅豫清淨。",
  "t765.82:1.2": "「於諸善法善觀時，宜而正修習。",
  "t765.82:1.3": "如是苾芻減省睡眠，具念正知，心常安住悅豫清淨，於諸善法善觀時宜而正修習，於二果中：隨證一果，謂於現法或證有餘依涅槃界，或不還果。」",
  "t765.82:2.0": "爾時，世尊重攝此義而說頌曰：",
  "t765.82:3.0": "「覺悟能聞法，",
  "t765.82:3.1": "修行得勝果，",
  "t765.82:3.2": "耽著於睡眠，",
  "t765.82:3.3": "都無有所得。",
  "t765.82:4.0": "減省睡眠者，",
  "t765.82:4.1": "具正念正知，",
  "t765.82:4.2": "善安住其心，",
  "t765.82:4.3": "常悅豫清淨。",
  "t765.82:5.0": "於諸善法中，",
  "t765.82:5.1": "知時宜修習，",
  "t765.82:5.2": "能究竟超越，",
  "t765.82:5.3": "生老病死苦。",
  "t765.82:6.0": "是故應勤修，",
  "t765.82:6.1": "減省睡眠法，",
  "t765.82:6.2": "常委觀寂靜，",
  "t765.82:6.3": "得二果無疑。",
  "t765.82:7.0": "或斷下分結，",
  "t765.82:7.1": "證得不還果；",
  "t765.82:7.2": "或斷上分結，",
  "t765.82:7.3": "度生老病死。」"
}