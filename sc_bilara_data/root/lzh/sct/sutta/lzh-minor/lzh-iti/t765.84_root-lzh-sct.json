{
  "t765.84:0.1": "本事經卷第四",
  "t765.84:0.2": "二法品第二之二",
  "t765.84:0.3": "(84)",
  "t765.84:0.4": "大唐三藏法師玄奘奉　詔譯",
  "t765.84:1.0": "吾從世尊聞如是語：",
  "t765.84:1.1": "「苾芻當知！若有苾芻無慚、無愧，彼人決定不能通達、不能遍知，不證等覺、不證涅槃、不能證得無上安樂。",
  "t765.84:1.2": "若有苾芻有慚、有愧，彼人決定能得通達、能得遍知，能證等覺、能證涅槃、能證究竟無上安樂。」",
  "t765.84:2.0": "爾時，世尊重攝此義而說頌曰：",
  "t765.84:3.0": "「無慚無愧者，",
  "t765.84:3.1": "懈怠不精進，",
  "t765.84:3.2": "多惛沈睡眠，",
  "t765.84:3.3": "去結盡為遠。",
  "t765.84:4.0": "有慚有愧者，",
  "t765.84:4.1": "常無有放逸，",
  "t765.84:4.2": "樂靜慮深定，",
  "t765.84:4.3": "去涅槃不遙。",
  "t765.84:5.0": "彼能斷眾結，",
  "t765.84:5.1": "及生老病死，",
  "t765.84:5.2": "速證三菩提，",
  "t765.84:5.3": "得無上安樂。」"
}