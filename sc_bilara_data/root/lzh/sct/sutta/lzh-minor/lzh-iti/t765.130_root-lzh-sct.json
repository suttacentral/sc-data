{
  "t765.130:0.1": "本事經卷第七",
  "t765.130:0.2": "三法品第三之二",
  "t765.130:0.3": "(130)",
  "t765.130:0.4": "大唐三藏法師玄奘奉　詔譯",
  "t765.130:1.0": "吾從世尊聞如是語：",
  "t765.130:1.1": "「苾芻當知！有三種法和合現前，能令淨信諸善男子生無量福。",
  "t765.130:1.2": "云何為三？",
  "t765.130:1.3": "一者淨信和合現前，能令淨信諸善男子生無量福。",
  "t765.130:1.4": "二者施物和合現前，能令淨信諸善男子生無量福。",
  "t765.130:1.5": "三者福田和合現前，能令淨信諸善男子生無量福。",
  "t765.130:1.6": "是名三法和合現前，能令淨信諸善男子生無量福。」",
  "t765.130:2.0": "爾時，世尊重攝此義而說頌曰：",
  "t765.130:3.0": "「三法合現前，",
  "t765.130:3.1": "能生無量福，",
  "t765.130:3.2": "謂淨信、施物，",
  "t765.130:3.3": "及真淨福田。",
  "t765.130:4.0": "具慧具尸羅，",
  "t765.130:4.1": "善調伏三毒，",
  "t765.130:4.2": "修沙門梵行，",
  "t765.130:4.3": "名真淨福田。",
  "t765.130:5.0": "具慧具淨信，",
  "t765.130:5.1": "手持如法財，",
  "t765.130:5.2": "奉施良福田，",
  "t765.130:5.3": "必當獲大果。",
  "t765.130:6.0": "身四威儀中，",
  "t765.130:6.1": "於三寶四諦，",
  "t765.130:6.2": "正順無瑕穢，",
  "t765.130:6.3": "名為淨信心。",
  "t765.130:7.0": "於諸惠施中，",
  "t765.130:7.1": "法施為最勝，",
  "t765.130:7.2": "淨心演正法，",
  "t765.130:7.3": "諸佛所稱譽。」"
}