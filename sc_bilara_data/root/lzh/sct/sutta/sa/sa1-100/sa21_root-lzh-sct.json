{
  "sa21:0.1": "雜阿含經 ",
  "sa21:0.2": "（一）陰相應 ",
  "sa21:0.3": "（二一） 動搖 ",
  "sa21:1.1": "如是我聞： ",
  "sa21:1.2": "一時，佛住舍衛國、祇樹、給孤獨園。 ",
  "sa21:2.1": "爾時，有異比丘從座起⋯為佛作禮⋯。 ",
  "sa21:2.2": "而白佛言： ",
  "sa21:2.3": "「世尊，為我略說法要。 ",
  "sa21:2.4": "我聞法已，當獨一靜處，專精思惟，不放逸住。 ",
  "sa21:2.5": "不放逸住已，思惟： ",
  "sa21:2.6": "『所以善男子⋯正信非家、出家⋯乃至⋯ ",
  "sa21:2.7": "自知不受後有。』」 ",
  "sa21:3.1": "爾時，世尊告彼比丘： ",
  "sa21:3.2": "「善哉，善哉！汝今作是說： ",
  "sa21:3.3": "『善哉，世尊，為我略說法要。 ",
  "sa21:3.4": "我聞法已，當獨一靜處，專精思惟，不放逸住⋯乃至⋯ ",
  "sa21:3.5": "「自知不受後有」』⋯耶？」 ",
  "sa21:4.1": "比丘白佛言： ",
  "sa21:4.2": "「如是，世尊。」 ",
  "sa21:5.1": "佛告比丘： ",
  "sa21:5.2": "「諦聽！諦聽，善思念之。 ",
  "sa21:5.3": "當為汝說。 ",
  "sa21:5.4": "比丘，動搖時則為魔所縛。 ",
  "sa21:5.5": "若不動者則解脫波旬。」 ",
  "sa21:6.1": "比丘白佛言： ",
  "sa21:6.2": "「知已，世尊！ ",
  "sa21:6.3": "知已，善逝！」 ",
  "sa21:7.1": "佛告比丘： ",
  "sa21:7.2": "「汝云何於我略說法中廣解其義？」 ",
  "sa21:8.1": "比丘白佛言： ",
  "sa21:8.2": "「世尊，色動搖時則為魔所縛。 ",
  "sa21:8.3": "若不動者則解脫波旬。 ",
  "sa21:8.4": "如是，受⋯想⋯行⋯識動搖時則為魔所縛。 ",
  "sa21:8.5": "若不動者則解脫波旬。 ",
  "sa21:8.6": "是故，我於世尊略說法中廣解其義。」 ",
  "sa21:9.1": "佛告比丘： ",
  "sa21:9.2": "「善哉！善哉，汝於我略說法中廣解其義。 ",
  "sa21:9.3": "所以者何？ ",
  "sa21:9.4": "若色動搖時則為魔所縛。 ",
  "sa21:9.5": "若不動者則解脫波旬。 ",
  "sa21:9.6": "如是，受⋯想⋯行⋯識動搖時則為魔所縛。 ",
  "sa21:9.7": "若不動者則解脫波旬。」 ",
  "sa21:10.1": "⋯乃至⋯自知不受後有⋯ ",
  "sa21:10.2": "心得解脫，成阿羅漢。 "
}